# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Configuration
# Option 1: Use service account JSON (recommended for production)
# Download from Firebase Console: Project Settings > Service Accounts > Generate New Private Key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option 2: Use project ID only (for local development)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Database Configuration (PostgreSQL - DEPRECATED, replaced by Firebase)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smartpepper
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Blockchain Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
PRIVATE_KEY=your_private_key_here

# IPFS Configuration
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# WebSocket Configuration
WS_PORT=3001

# Platform Configuration
PLATFORM_FEE_PERCENT=2
MIN_BID_INCREMENT=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
